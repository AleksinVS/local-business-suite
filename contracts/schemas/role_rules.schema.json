{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Role Rules Configuration",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "$administration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role_assignment_allowlist": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "required": ["role_assignment_allowlist"]
    },
    "$capabilities": {
      "type": "object",
      "description": "Справочник прав: понятные названия и комментарии для нетехнических пользователей.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["flag", "scope", "targets"] },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "section": { "enum": ["workorders", "organization", "ai_memory", "personal_data"] },
          "risk": { "enum": ["normal", "elevated", "critical"] }
        },
        "required": ["type", "label", "description", "section", "risk"]
      }
    }
  },
  "patternProperties": {
    "^[a-zA-Z0-9_]+$": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": { "type": "string" },
        "description": { "type": "string" },
        "view_scope": {
          "enum": ["all", "department_branch", "assigned_or_unassigned_or_authored", "authored", "none"]
        },
        "create_workorder": { "type": "boolean" },
        "edit_scope": { "type": "string" },
        "comment_scope": { "type": "string" },
        "upload_attachment_scope": { "type": "string" },
        "confirm_closure_scope": { "type": "string" },
        "rate_scope": { "type": "string" },
        "transition_scope": { "type": "string" },
        "transition_targets": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "enum": ["*"] }
          ]
        },
        "manage_inventory": { "type": "boolean" },
        "manage_board_columns": { "type": "boolean" },
        "manage_assignments": { "type": "boolean" },
        "view_analytics": { "type": "boolean" },
        "manage_departments": { "type": "boolean" },
        "manage_roles": { "type": "boolean" },
        "manage_ai_skills": { "type": "boolean" },
        "memory_organization_write": { "type": "boolean" },
        "memory_organization_review": { "type": "boolean" },
        "view_waiting_list": { "type": "boolean" },
        "create_waiting_list": { "type": "boolean" }
      },
      "required": [
        "view_scope",
        "create_workorder",
        "edit_scope",
        "comment_scope",
        "upload_attachment_scope",
        "confirm_closure_scope",
        "rate_scope",
        "transition_scope",
        "transition_targets",
        "manage_inventory",
        "manage_board_columns",
        "manage_assignments",
        "view_analytics",
        "manage_departments",
        "manage_roles",
        "manage_ai_skills",
        "memory_organization_write",
        "memory_organization_review",
        "view_waiting_list",
        "create_waiting_list"
      ]
    }
  },
  "required": ["$schema", "$capabilities"],
  "additionalProperties": false
}
