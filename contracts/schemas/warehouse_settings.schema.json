{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-business-suite.invalid/schemas/warehouse_settings.schema.json",
  "title": "Warehouse runtime settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["default_quantity_precision", "expiry_warning_days"],
  "properties": {
    "default_quantity_precision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "expiry_warning_days": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0},
      "uniqueItems": true
    }
  }
}
