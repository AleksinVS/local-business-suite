{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Role Rules Configuration",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "$administration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role_assignment_allowlist": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "required": ["role_assignment_allowlist"]
    },
    "$capabilities": {
      "type": "object",
      "description": "Справочник прав: понятные названия и комментарии для нетехнических пользователей.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["flag", "scope", "targets"] },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "section": { "enum": ["workorders", "organization", "ai_memory", "personal_data", "waiting_list"] },
          "risk": { "enum": ["normal", "elevated", "critical"] },
          "values_source": {
            "enum": ["workorder_scopes", "waiting_list_scopes", "workorder_statuses", "waiting_list_statuses"]
          }
        },
        "required": ["type", "label", "description", "section", "risk"],
        "allOf": [
          {
            "if": {
              "required": ["type"],
              "properties": { "type": { "enum": ["scope", "targets"] } }
            },
            "then": { "required": ["values_source"] }
          },
          {
            "if": {
              "required": ["type"],
              "properties": { "type": { "const": "flag" } }
            },
            "then": { "not": { "required": ["values_source"] } }
          }
        ]
      }
    }
  },
  "patternProperties": {
    "^[a-zA-Z0-9_]+$": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": { "type": "string" },
        "description": { "type": "string" },
        "view_scope": {
          "enum": ["none", "all", "visible", "authored", "department_branch", "assigned", "assigned_or_unassigned", "assigned_or_unassigned_or_authored"]
        },
        "create_workorder": { "type": "boolean" },
        "edit_scope": { "type": "string", "enum": ["none", "all", "visible", "authored", "department_branch", "assigned", "assigned_or_unassigned", "assigned_or_unassigned_or_authored"] },
        "comment_scope": { "type": "string", "enum": ["none", "all", "visible", "authored", "department_branch", "assigned", "assigned_or_unassigned", "assigned_or_unassigned_or_authored"] },
        "upload_attachment_scope": { "type": "string", "enum": ["none", "all", "visible", "authored", "department_branch", "assigned", "assigned_or_unassigned", "assigned_or_unassigned_or_authored"] },
        "confirm_closure_scope": { "type": "string", "enum": ["none", "all", "visible", "authored", "department_branch", "assigned", "assigned_or_unassigned", "assigned_or_unassigned_or_authored"] },
        "rate_scope": { "type": "string", "enum": ["none", "all", "visible", "authored", "department_branch", "assigned", "assigned_or_unassigned", "assigned_or_unassigned_or_authored"] },
        "transition_scope": { "type": "string", "enum": ["none", "all", "visible", "authored", "department_branch", "assigned", "assigned_or_unassigned", "assigned_or_unassigned_or_authored"] },
        "transition_targets": {
          "oneOf": [
            { "type": "array", "uniqueItems": true, "items": { "enum": ["new", "accepted", "in_progress", "on_hold", "resolved", "closed", "cancelled"] } },
            { "enum": ["*"] }
          ]
        },
        "manage_inventory": { "type": "boolean" },
        "manage_board_columns": { "type": "boolean" },
        "manage_assignments": { "type": "boolean" },
        "view_analytics": { "type": "boolean" },
        "manage_departments": { "type": "boolean" },
        "manage_roles": { "type": "boolean" },
        "manage_ai_skills": { "type": "boolean" },
        "memory_organization_write": { "type": "boolean" },
        "memory_organization_review": { "type": "boolean" },
        "create_waiting_list": { "type": "boolean" },
        "waiting_list_view_scope": { "enum": ["none", "authored", "all"] },
        "waiting_list_edit_scope": { "enum": ["none", "authored", "all"] },
        "waiting_list_edit_statuses": {
          "oneOf": [
            {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["waiting", "scheduled", "confirmed", "cancelled"] }
            },
            { "enum": ["*"] }
          ]
        },
        "waiting_list_transition_scope": { "enum": ["none", "authored", "all"] },
        "waiting_list_transition_from_statuses": {
          "oneOf": [
            {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["waiting", "scheduled", "confirmed", "cancelled"] }
            },
            { "enum": ["*"] }
          ]
        },
        "waiting_list_transition_targets": {
          "oneOf": [
            {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["waiting", "scheduled", "confirmed", "cancelled"] }
            },
            { "enum": ["*"] }
          ]
        }
      },
      "required": [
        "view_scope",
        "create_workorder",
        "edit_scope",
        "comment_scope",
        "upload_attachment_scope",
        "confirm_closure_scope",
        "rate_scope",
        "transition_scope",
        "transition_targets",
        "manage_inventory",
        "manage_board_columns",
        "manage_assignments",
        "view_analytics",
        "manage_departments",
        "manage_roles",
        "manage_ai_skills",
        "memory_organization_write",
        "memory_organization_review",
        "create_waiting_list",
        "waiting_list_view_scope",
        "waiting_list_edit_scope",
        "waiting_list_edit_statuses",
        "waiting_list_transition_scope",
        "waiting_list_transition_from_statuses",
        "waiting_list_transition_targets"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "waiting_list_edit_scope": { "const": "none" } }
          },
          "then": {
            "properties": { "waiting_list_edit_statuses": { "const": [] } }
          }
        },
        {
          "if": {
            "properties": { "waiting_list_edit_scope": { "enum": ["authored", "all"] } }
          },
          "then": {
            "properties": {
              "waiting_list_edit_statuses": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "enum": ["waiting", "scheduled", "confirmed", "cancelled"] }
                  },
                  { "const": "*" }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "waiting_list_transition_scope": { "const": "none" } }
          },
          "then": {
            "properties": {
              "waiting_list_transition_from_statuses": { "const": [] },
              "waiting_list_transition_targets": { "const": [] }
            }
          }
        },
        {
          "if": {
            "properties": { "waiting_list_transition_scope": { "enum": ["authored", "all"] } }
          },
          "then": {
            "properties": {
              "waiting_list_transition_from_statuses": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "enum": ["waiting", "scheduled", "confirmed", "cancelled"] }
                  },
                  { "const": "*" }
                ]
              },
              "waiting_list_transition_targets": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "enum": ["waiting", "scheduled", "confirmed", "cancelled"] }
                  },
                  { "const": "*" }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "required": ["$schema", "$capabilities"],
  "additionalProperties": false
}
